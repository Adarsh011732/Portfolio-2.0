# ==========================================
# PORTFOLIO DATABASE CONFIGURATION (MongoDB Atlas)
# ==========================================
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/portfolio?retryWrites=true&w=majority

# ==========================================
# OWNER AUTHENTICATION (email OTP is the only login method)
# ==========================================
OWNER_EMAIL=your_email@gmail.com
# LEGACY: not a login method anymore - keep placeholders in example files
OWNER_PASSKEY=disabled

# Session cookie signing secret (min 32 chars) - REQUIRED for stable sessions
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=

# Nodemailer / Gmail SMTP Configuration (required for OTP delivery)
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_16_char_app_password
EMAIL_SERVICE=gmail

# Local Dev Port & CORS
PORT=3001
# Unset = same-origin only in production; localhost allowed in development.
# FRONTEND_URL=http://localhost:5173
