# ==========================================
# PORTFOLIO DATABASE CONFIGURATION (MongoDB Atlas)
# ==========================================
# Get a free database at https://www.mongodb.com/cloud/atlas
# Format: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/portfolio?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/portfolio?retryWrites=true&w=majority

# ==========================================
# OWNER AUTHENTICATION (email OTP is the only login method)
# ==========================================

# Owner Email (where login OTPs will be delivered)
OWNER_EMAIL=your_email@gmail.com

# LEGACY: Owner Passkey is NO LONGER a login method (OTP-only authentication).
# Keep placeholders here — never put real passkeys in example files.
OWNER_PASSKEY=disabled

# Session cookie signing secret (min 32 chars) - REQUIRED for stable owner sessions.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=

# ==========================================
# Nodemailer / Gmail SMTP Configuration (required for OTP delivery)
# ==========================================
# Create an App Password in your Google Account:
# Security -> 2-Step Verification -> App Passwords
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_16_char_app_password
EMAIL_SERVICE=gmail

# ==========================================
# CORS (leave unset for single-domain deployments - recommended)
# ==========================================
# Unset = same-origin only (Vercel serves the SPA and /api on one domain).
# For split deployments set an EXACT comma-separated allowlist:
# FRONTEND_URL=https://your-portfolio.vercel.app
# NEVER combine "*" with credentialed requests.
